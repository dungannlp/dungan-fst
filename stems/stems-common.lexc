вынмин:вынмин    T1-N-NN ;       ! 文明 "civilization"
шыҗе:шыҗе        T3-N-NN ;       ! 世界 "world"
дычү:дычү        N-NN ;       ! 地區 "region"
дифон:дифон      T3-N-NN ;       ! 地方 "place"
чын:чын          T3-N-NN ;       ! 城 "city"
сан:сан          N-NN ;       ! 山 "mountain" / 田 "field"
хә:хә            N-NN ;       ! 河 "river"
тян:тян          T1-N-NN ;       ! 天 "sky, day"
