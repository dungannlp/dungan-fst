! ============================================================================
! POSTPOSITIONS / LOCALIZERS
! ============================================================================

LEXICON Postpositions

шон:шон          Post ;       ! 上 "on, above"
ни:ни            Post ;       ! 裡 "in" (locative)
литу:литу        Post ;       ! 裡頭 "inside"
гынчян:гынчян    Post ;       ! 跟前 "near, beside"
яншон:яншон      Post ;       ! "onto, toward"


! ============================================================================
! CONJUNCTIONS
! ============================================================================

LEXICON Conjunctions

дэ:дэ            CnjCoo ;     ! 得/和 "and"
лян:лян          CnjCoo ;     ! 連 "and, with"
кәсы:кәсы        CnjCoo ;     ! "but"
данпа:данпа      CnjCoo ;     ! "but, however"
кэшы:кэшы        CnjCoo ;     ! 可是 "but"
йинцысы:йинцысы  CnjSub ;     ! "because"
зущён:зущён      CnjSub ;     ! "as if, like"


! ============================================================================
! PARTICLES
! ============================================================================

LEXICON Particles

ба:ба            PartBa ;     ! 把 pretransitive / object marker
ги:ги            PartGi ;     ! 給 dative "to, for"
ди:ди            PartGen ;    ! 的 genitive/attributive
ли:ли            PartLi ;     ! 哩/了 sentence-final perfective
ни:ни            PartNi ;     ! 呢 sentence-final


! ============================================================================
! INTERJECTIONS
! ============================================================================

LEXICON Interjections

ама:ама          Ij ;         ! "mama/papa (address)"
о:о              Ij ;         ! "oh"
он:он            Ij ;         ! "uh-huh"


! ============================================================================
! COVERAGE EXPANSION — frequent items from the Dungan Wikipedia corpus.
! Glosses grounded in Chinese-character etymology + corpus context (the
! articles are largely geography/politics/religion). Added after initial
! coverage measurement; see tests/coverage.py.
! ============================================================================

LEXICON NounsExtra

! --- high-frequency inanimate nouns ---
шын:шын          N-NN ;       ! 省 "province"
җин:җин          T2-N-NN ;       ! 京 "capital" / 金 "gold"
йуэ:йуэ          N-NN ;       ! 月 "month"
фын:фын          N-NN ;       ! 分 "part, minute" / 風 "wind"
йүан:йүан        N-NN ;       ! 元 / 員 "member, unit"
җинҗы:җинҗы      N-NN ;       ! 經濟 "economy"
жынмин:жынмин    T1-N-NN ;       ! 人民 "people"
гунхәгуй:гунхәгуй N-NN ;      ! 共和國 "republic"
дабу:дабу        N-NN ;       ! "majority, most part"
вуйүан:вуйүан    N-NN ;       ! 委員 "committee member"
дынҗы:дынҗы      N-NN ;       ! "等級 rank" (context)

! --- proper-noun components frequently standalone in the corpus ---
Хуэй:Хуэй        Np ;         ! 回 Hui

LEXICON VerbsExtra

җё:җё            V ;          ! 叫 "call, be called" / 教 "teach"
до:до            V ;          ! 到 "arrive, reach"
чў:чў            V ;          ! 出 "exit, come out"
йу:йу            V ;          ! 有 "have" (Shaanxi/var of ю)
ги:ги            V ;          ! 給 "to give" (main verb; folk_tale 把三個女子給哩人哩 → гили 給哩 "gave"; cf. ги<post> dative clitic)
лай:лай          V ;          ! 來 "to come" (folk_tale 來説他達呢 → лай шә "came [and] said"; fuller variant of лэ 來)

LEXICON AdjExtra

җун:җун          Adj ;        ! 重 "heavy, important" / 中 "central"

! ---- Negation particles (preposed) ----
! бу 不 and мә 沒 are listed above under Adverbs (matching their Chinese
! adverbial status). The prohibitive бә 叵/嫑 ("don't", imperative only) is a
! distinct mood marker and is given the <neg> tag. Heavily attested in the
! corpus (Ни бә җё "don't shout"; ду бә зў "don't do"). [Цунвазо 1949]
LEXICON Negators

бә:бә            Neg ;        ! 叵/嫑 "don't" (prohibitive)
