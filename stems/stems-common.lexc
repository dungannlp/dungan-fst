! ============================================================================
! stems/stems-common.lexc  —  DIALECT-NEUTRAL STEMS
!
! Vocabulary shared by all Dungan dialects. Concatenated after the root
! morphotactics file and before exactly one stems-<dialect>.lexc file.
!
! The dialect files ADD to the POS lexicons opened here (Nouns, Verbs, ...)
! and supply the forms that differ between Gansu and Shaanxi (copula,
! 1sg/1pl pronouns, a few finals). Everything regular lives here.
! ============================================================================

! ============================================================================
! PRONOUNS  (dialect-neutral members; вә/ңә-paradigm split lives in dialect files)
! ============================================================================

LEXICON Pronouns

! --- Personal: 2nd/3rd person are shared across dialects ---
ни:ни        PrnPersSg2 ;     ! 你 "you (sg)"
та:та        PrnPersSg3 ;     ! 他 "he/she/it"
ниму:ниму    PrnPersPl2 ;     ! 你們 "you (pl)"
за:за        PrnPersPl1i ;    ! 咱 "we (incl.)"
заму:заму    PrnPersPl1i ;    ! 咱們 "we (incl.)"

! --- Demonstratives (shared) ---
җыгә:җыгә     PrnDemEnd ;      ! 這個 "this"
җәгә:җәгә     PrnDemEnd ;      ! 這個 "this" (variant)
нагә:нагә     PrnDemEnd ;      ! 那個 "that"
ныйгә:ныйгә   PrnDemEnd ;      ! 那個 "that" (variant)

! --- Interrogatives (shared) ---
са:са        PrnItgEnd ;      ! 啥 "what"
сый:сый      PrnItgEnd ;      ! 誰 "who"
зуа:зуа      PrnItgEnd ;      ! 做啥 "why"
зали:зали    PrnItgEnd ;      ! 咋哩 "how"

! Person/number sub-entries that route shared pronouns into the possessive slot.
LEXICON PrnPersSg2
%<prn%>%<pers%>%<p2%>%<sg%>:  PrnPossSlot ;

LEXICON PrnPersSg3
%<prn%>%<pers%>%<p3%>%<sg%>:  PrnPossSlot ;

LEXICON PrnPersPl2
%<prn%>%<pers%>%<p2%>%<pl%>:  PrnPossSlot ;

LEXICON PrnPersPl1i
%<prn%>%<pers%>%<p1%>%<pl%>%<incl%>:  PrnPossSlot ;


! ============================================================================
! NOUNS
! ============================================================================

LEXICON Nouns

! --- Animate (take -му plural) ---
жын:жын          T1-N-AN ;       ! 人 "person"
есын:есын        T2-N-AN ;       ! "wild animal" (folk tales)
лохан:лохан      T2-N-AN ;       ! 老漢 "old man"
лопәр:лопәр      N-AN ;       ! 老婆兒 "old woman / wife"
нүзы:нүзы        N-AN ;       ! 女子 "daughter / girl"
эрзы:эрзы        T1-N-AN ;       ! 兒子 "son"
вава:вава        T1-N-AN ;       ! 娃 "child"
эр:эр            N-AN ;       ! 兒 "son, child"
ва:ва            N-AN ;       ! 娃 "child, kid"
гуә:гуә          N-NN ;       ! 鍋 "pot, wok"
эр:эр            Num ;        ! 二 "two" (ordinal/counting эр)
дада:дада        T1-N-AN ;       ! 達達 "father (address)"
мама:мама        T1-N-AN ;       ! 媽媽 "mother"
гўнён:гўнён      T1-N-AN ;       ! "girl, maiden"
мучин:мучин      T2-N-AN ;       ! 母親 "mother"
фучин:фучин      N-AN ;       ! 父親 "father"
лон:лон          T1-N-AN ;       ! 狼 "wolf"
ху:ху            N-AN ;       ! 狐 "fox"
мо:мо            N-AN ;       ! 馬 "horse"
ён:ён            T1-N-AN ;       ! 羊 "sheep"
гу:гу            N-AN ;       ! 狗 "dog"
минзў:минзў      T1-N-AN ;       ! 民族 "people, nation"
сыҗя:сыҗя        T1-N-AN ;       ! "writer"
кә:кә        N-AN ;       ! 客 "guest"
жынму:жынму      T1-N-AN ;       ! 人們 "people" (lexicalized pl)

! --- Inanimate (invariant) ---
гуйҗя:гуйҗя      T1-N-NN ;       ! 國家 "country"
гуй:гуй          N-NN ;       ! 國 "country, state"
йүян:йүян        T2-N-NN ;       ! 語言 "language"
хуа:хуа          N-NN ;       ! 話 "speech, language"
фу:фу            N-NN ;       ! 書 "book"
