щин:щин          T1-N-NN ;       ! 心 "heart"
мин:мин          T1-N-NN ;       ! 命 / 名 "life / name"
лў:лў            T3-N-NN ;       ! 路 "road"
чё:чё            N-NN ;       ! 橋 "bridge"
жынку:жынку      N-NN ;       ! 人口 "population"
шычи:шычи        N-NN ;       ! 時期 "period, era"
җя:җя            T1-N-NN ;       ! 家 "home, family"
цун:цун          N-NN ;       ! 葱 "green onion"
җюцай:җюцай      N-NN ;       ! 韭菜 "leek"
