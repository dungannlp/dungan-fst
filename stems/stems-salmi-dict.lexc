! ============================================================================
! stems/stems-salmi-dict.lexc — vocabulary from Olli Salmi,
! "Dungan-English Dictionary" (Manchester: Eastbridge Books, 2018;
! http://www.tsalo.fi/Dungan-English%20Dictionary.pdf).
! Each entry is a corpus gap token found as a single-word headword in the
! dictionary; part of speech, tone (Gansu, 3-tone), hanzi and gloss are taken
! from the dictionary entry. Nouns are routed inanimate (N-NN) by default to
! avoid -му over-generation. Dialect-neutral (shared pool).
! ============================================================================

LEXICON SalmiDict

гў:гў                 V ;           ! 顾 v "care"                                    [Salmi 2018]
гын:гын               T1-N-NN ;     ! 根 n "root"                                    [Salmi 2018]
бэвон:бэвон           V ;           ! 拜望 v "worship"                                [Salmi 2018]
бэ:бэ                 V ;           ! 败 v "lose (a fight)"                          [Salmi 2018]
ле:ле                 V ;           ! 咧 v "grimace"                                 [Salmi 2018]
я:я                   V ;           ! 压 v "lower, press down?"                      [Salmi 2018]
бонҗер:бонҗер         Adv ;         ! 帮间⼉儿帮尖⼉儿帮肩⼉儿 adv ""                           [Salmi 2018]
вэ:вэ                 Adj ;         ! 歪 adj "tough, capable, sharp (of eyes)"       [Salmi 2018]
бошы:бошы             T2-N-NN ;     ! 宝⽯石 n "precious stone, gem"                   [Salmi 2018]
вынзы:вынзы           T1-N-NN ;     ! 蚊⼦子 n "mosquito"                              [Salmi 2018]
