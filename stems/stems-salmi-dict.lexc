билүн:билүн           T2-N-NN ;     ! ⽐比论 n "example"                               [Salmi 2018]
боҗон:боҗон           V ;           ! 报账 v "to report"                              [Salmi 2018]
бусы:бусы             T1-V ;        ! 不是 v "is not"                                 [Salmi 2018]
быйбон:быйбон         V ;           ! 背绑 v "tie behind the back"                    [Salmi 2018]
бё:бё                 V ;           ! — v "to mount a horse, to jump on a horse"    [Salmi 2018]
ви:ви                 V ;           ! 围⾜足畏 v "move to a place, move"                [Salmi 2018]
воншы:воншы           T3-Adj ;      ! 旺实 adj "plentиful"                            [Salmi 2018]
